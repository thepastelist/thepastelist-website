// Cloudflare Worker config for the static site (Workers Builds reads this on every push).
// "name" must stay exactly the same as the Worker in the Cloudflare dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thepastelist-website",
  "compatibility_date": "2026-09-26",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    // serve our own 404.html (with a 404 status) for unknown URLs
    "not_found_handling": "404-page"
  }
}
